#: schemas/org.gnome.shell.extensions.rumo.gschema.xml:6 src/prefs.ts:143
msgid "Enable XWayland clipboard paste fallback"
msgstr "启用 XWayland 剪贴板粘贴回退"

#: schemas/org.gnome.shell.extensions.rumo.gschema.xml:7
msgid ""
"When the focused window has no Wayland text-input context and non-ASCII text "
"is committed, temporarily paste via clipboard and restore previous clipboard "
"contents."
msgstr ""
"当焦点窗口没有 Wayland 文本输入上下文且提交非 ASCII 文本时，通过剪贴板临时"
"粘贴并恢复原有剪贴板内容。"

#: schemas/org.gnome.shell.extensions.rumo.gschema.xml:15
msgid "Keyboard display mode"
msgstr "键盘展示模式"

#: schemas/org.gnome.shell.extensions.rumo.gschema.xml:16
msgid ""
"How the on-screen keyboard interacts with open windows: overlay on top or "
"push windows upward."
msgstr "控制屏幕键盘与打开窗口的交互方式：覆盖在顶层显示，或将屏幕窗口向上顶起。"

#: schemas/org.gnome.shell.extensions.rumo.gschema.xml:21
msgid "Keyboard height ratio relative to monitor height"
msgstr "键盘高度占显示器高度的比例"

#: schemas/org.gnome.shell.extensions.rumo.gschema.xml:22
msgid ""
"Height of the on-screen keyboard as a fraction of the active monitor height."
msgstr "屏幕键盘高度占当前显示器高度的比例。"

#: schemas/org.gnome.shell.extensions.rumo.gschema.xml:26 src/prefs.ts:131
msgid "Show top bar toggle indicator"
msgstr "显示顶栏切换指示器"

#: schemas/org.gnome.shell.extensions.rumo.gschema.xml:27 src/prefs.ts:132
msgid "Show a keyboard toggle button in the GNOME Shell top bar."
msgstr "在 GNOME Shell 顶栏中显示虚拟键盘切换按钮。"

#: schemas/org.gnome.shell.extensions.rumo.gschema.xml:31
msgid "Recently used symbols"
msgstr "最近使用的符号"

#: schemas/org.gnome.shell.extensions.rumo.gschema.xml:32
msgid ""
"Ordered list of recently used symbols in the symbol picker (most recent "
"first)."
msgstr "符号面板中最近使用符号的有序列表（最近使用的排在前面）。"

#: src/platform/oskManager.ts:188
msgid "Rumo Keyboard"
msgstr "如梦虚拟键盘"

#: src/prefs.ts:24
msgid "General"
msgstr "常规"

#: src/prefs.ts:29
msgid "Display & Layout"
msgstr "显示与布局"

#: src/prefs.ts:33
msgid "Overlay on top"
msgstr "覆盖在顶上"

#: src/prefs.ts:34
msgid "Push screen up"
msgstr "把屏幕顶上去"

#: src/prefs.ts:37
msgid "Display mode"
msgstr "展示模式"

#: src/prefs.ts:39
msgid ""
"Choose whether the keyboard floats over windows or pushes windows upward."
msgstr "选择键盘是覆盖在窗口上方，还是将屏幕窗口向上顶起。"

#: src/prefs.ts:70
msgid "Keyboard height"
msgstr "键盘高度"

#: src/prefs.ts:71
msgid "Height of the keyboard as a percentage of the screen height."
msgstr "键盘高度占屏幕高度的百分比。"

#: src/prefs.ts:127
msgid "Integration"
msgstr "系统集成"

#: src/prefs.ts:145
msgid ""
"Temporarily paste via clipboard when a window lacks native text-input "
"support."
msgstr "当窗口不支持原生文本输入协议时，通过剪贴板临时粘贴文本。"

#: src/ui/candidateBar.ts:118 src/ui/candidateBar.ts:414
msgid "Overlay"
msgstr "覆盖顶层"

#: src/ui/candidateBar.ts:148
msgid "Settings"
msgstr "设置"

#: src/ui/candidateBar.ts:410
msgid "Push screen"
msgstr "顶起屏幕"

#: src/ui/candidateDrawer.ts:182
msgid "Loading more…"
msgstr "正在加载更多…"

#: src/ui/candidateDrawer.ts:182
msgid "Load more candidates"
msgstr "加载更多候选词"

#: src/ui/keyButton.ts:98
msgid "Space"
msgstr "空格"

#: src/ui/symbolPickerView.ts:260
msgid "No recently used symbols"
msgstr "暂无最近使用的符号"
